# VISiOnRoute — örnek yapılandırma. Kopyalayın: cp .env.example .env
# GERÇEK SIRLARI ASLA BU DEPOYA KOYMAYIN. Üretimde AWS Secrets Manager kullanılır.

# --- Ortam ---
VISIONROUTE_ENVIRONMENT=local            # local | development | staging | production
VISIONROUTE_DEBUG=true

# --- Veritabanı ---
VISIONROUTE_DATABASE_URL=postgresql+asyncpg://visionroute:visionroute@localhost:5433/visionroute

# --- Redis (önbellek + hız sınırlama) ---
VISIONROUTE_REDIS_URL=redis://localhost:6379/0
# memory: yalnızca yerel/test (süreç başına sayaç). Üretim benzeri ortamda redis zorunlu.
VISIONROUTE_RATE_LIMIT_BACKEND=memory

# --- JWT imzalama (RS256). Geliştirme anahtarı üretin: ---
#   poetry run visionroute keys generate --out .dev/keys
VISIONROUTE_JWT_PRIVATE_KEY_PATH=.dev/keys/jwt-private.pem
VISIONROUTE_JWT_PUBLIC_KEY_PATH=.dev/keys/jwt-public.pem
VISIONROUTE_JWT_ISSUER=visionroute
VISIONROUTE_JWT_AUDIENCE=visionroute-api
VISIONROUTE_ACCESS_TOKEN_TTL_SECONDS=900
VISIONROUTE_REFRESH_TOKEN_TTL_SECONDS=1209600

# --- Alan şifreleme (webhook sırları, MFA sırları) ---
# Üretin ve çıktıyı buraya yapıştırın (değeri depoya eklemeyin):
#   poetry run visionroute keys generate-field-key --key-id k1
# VISIONROUTE_FIELD_ENCRYPTION_KEYS='{"k1": "<44 karakterlik anahtar>"}'
# VISIONROUTE_FIELD_ENCRYPTION_PRIMARY_KEY_ID=k1

# --- Web ---
VISIONROUTE_CORS_ORIGINS=["http://localhost:3000"]
VISIONROUTE_COOKIE_SECURE=false           # üretimde true
VISIONROUTE_PUBLIC_APP_URL=http://localhost:3000

# --- E-posta ---
# file: .localdata/mail altına .eml yazar (Docker'sız yerel geliştirme)
# smtp: Mailpit (docker compose, localhost:1025 / arayüz :8025) veya üretim sağlayıcısı
VISIONROUTE_MAIL_BACKEND=file
VISIONROUTE_SMTP_HOST=localhost
VISIONROUTE_SMTP_PORT=1025
VISIONROUTE_SMTP_FROM=no-reply@visionroute.local
# VISIONROUTE_SMTP_USERNAME=
# VISIONROUTE_SMTP_PASSWORD=
# VISIONROUTE_SMTP_STARTTLS=false

# --- Nesne depolama (yerelde MinIO) ---
VISIONROUTE_S3_ENDPOINT_URL=http://localhost:9000
VISIONROUTE_S3_BUCKET_EVIDENCE=visionroute-evidence
VISIONROUTE_S3_ACCESS_KEY_ID=visionroute
VISIONROUTE_S3_SECRET_ACCESS_KEY=visionroute-dev-only

# --- AI yardımı (varsayılan kapalı) ---
VISIONROUTE_AI_ASSIST_ENABLED=false
# VISIONROUTE_AI_PROVIDER=anthropic
# VISIONROUTE_AI_API_KEY=

# --- Admin bootstrap (etkileşimsiz kurulum için; kurulumdan sonra silin) ---
# VISIONROUTE_BOOTSTRAP_ADMIN_EMAIL=
# VISIONROUTE_BOOTSTRAP_ADMIN_PASSWORD=
